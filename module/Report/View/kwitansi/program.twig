<table class="table-input table-input-top">
    <tr>
        <td class="pr-10"> Program Belajar </td>
        <td class="pr-10"> : </td>
        {% for program in program_belajars %}
        <td class="pr-10">
            <div class="checkbox-pdf">
                <input type="checkbox" {{ tagihan.program_belajar==program.nama ? 'checked' : '' }}>
            </div> {{ program.nama }}
        </td>
        {% endfor %}
        <td class="pr-10">
            <div class="checkbox-pdf">
                <input type="checkbox" {{ program_belajar_is_other ? 'checked' : '' }}>
            </div>
            <div class="other-options">{{ program_belajar_is_other ? tagihan.program_belajar : '' }}</div>
        </td>
    </tr>
    <tr>
        <td class="pr-10"></td>
        <td></td>
        {% for program in program_belajars %}
        <td class="pr-10">
            <div class="checkbox-no-border"></div>
            <span class="mandarin">{{ program.nama_mandarin }}</span>
        </td>
        {% endfor %}
    </tr>

    <tr>
        <td><br></td>
    </tr>

    <tr>
        <td class="pr-10"> Jenis Pembayaran </td>
        <td class="pr-10"> : </td>
        <td class="pr-10">
            <div class="checkbox-pdf">
                <input type="checkbox" {{ tagihan.jenis_pembayaran=='Tunai' ? 'checked' : '' }}>
            </div> Tunai
        </td>
        <td class="pr-10">
            <div class="checkbox-pdf">
                <input type="checkbox" {{ tagihan.jenis_pembayaran=='Transfer' ? 'checked' : '' }}>
            </div> Transfer
        </td>
        <td class="pr-10">
            <div class="checkbox-pdf">
                <input type="checkbox" {{ tagihan.jenis_pembayaran=='Cek' ? 'checked' : '' }}>
            </div> Cek
        </td>
        <td class="pr-10">
            <div class="checkbox-pdf">
                <input type="checkbox" {{ tagihan.jenis_pembayaran=='Bilyet Giro' ? 'checked' : '' }}>
            </div> Bilyet Giro
        </td>
    </tr>
    <tr>
        <td class="pr-10">
            <div class="checkbox-no-border"></div>
            <span class="mandarin">付款方式</span>
        </td>
        <td></td>
        <td class="pr-10">
            <div class="checkbox-no-border"></div>
            <span class="mandarin">现金</span>
        </td>
        <td class="pr-10">
            <div class="checkbox-no-border"></div>
            <span class="mandarin">汇款</span>
        </td>
        <td class="pr-10">
            <div class="checkbox-no-border"></div>
            <span class="mandarin">支票</span>
        </td>
        <td class="pr-10">
            <div class="checkbox-no-border"></div>
            <span class="mandarin">转账支票</span>
        </td>
    </tr>
</table>
