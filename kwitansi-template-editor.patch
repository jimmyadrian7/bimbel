+(() => {
+    "use strict";
+
+    angular.module('app.module.konfigurasi.template_kwitansi')
+        .controller('TemplateKwitansiController', TemplateKwitansiController);
+
+    TemplateKwitansiController.$inject = ['$scope', '$window', '$timeout', 'req', 'logger'];
+
+    function TemplateKwitansiController($scope, $window, $timeout, req, logger)
+    {
+        let vm = this;
+        const URL = 'report/template/kwitansi';
+        let previewUrl = null;
+
+        vm.loaded = false;
+        vm.installed = true;
+        vm.mode = 'visual'; // 'visual' (drag & drop settings) | 'kode' (edit the Twig text)
+        vm.layout = null;
+        vm.layoutSaved = null;
+        vm.layoutStandar = null;
+        vm.blocks = {};
+        vm.limits = {};
+        vm.sections = [];
+        vm.active = null;
+        vm.examples = {};
+        vm.variables = [];
+        vm.allowed = {};
+        vm.programCount = 0;
+        vm.showHelp = false;
+        vm.saving = false;
+        vm.saveError = null;
+        vm.preview = { tagihanId: '', status: 'l', loading: false, pages: null, error: null };
+
+        vm.select = select;
+        vm.moveBlock = moveBlock;
+        vm.shiftBlock = shiftBlock;
+        vm.isLayoutChanged = isLayoutChanged;
+        vm.isLayoutCustom = isLayoutCustom;
+        vm.resetLayout = resetLayout;
+        vm.programCustom = programCustom;
+        vm.insertVariable = insertVariable;
+        vm.hasSectionError = hasSectionError;
+        vm.isChanged = isChanged;
+        vm.isCustom = isCustom;
+        vm.hasUnsaved = hasUnsaved;
+        vm.resetSection = resetSection;
+        vm.discardAll = discardAll;
+        vm.applyExample = applyExample;
+        vm.refreshPreview = refreshPreview;
+        vm.save = save;
+
+        activate();
+
+        function activate()
+        {
+            req.get(URL).then(state => {
+                applyState(state, null);
+                vm.loaded = true;
+
+                // Show right away how the receipt looks with today's program list.
+                if (vm.installed)
+                {
+                    refreshPreview();
+                }
+            }).catch(angular.noop);
+        }
+
+        function applyState(state, keepActive)
+        {
+            vm.installed = state.terpasang;
+            vm.examples = state.contoh || {};
+            vm.variables = state.variabel || [];
+            vm.allowed = state.diizinkan || {};
+            vm.programCount = state.jumlah_program;
+            vm.layout = angular.copy(state.layout);
+            vm.layoutSaved = angular.copy(state.layout);
+            vm.layoutStandar = angular.copy(state.layout_standar);
+            vm.limits = state.batas || {};
+            vm.blocks = {};
+            (state.blok || []).forEach(b => vm.blocks[b.key] = b.label);
+            vm.sections = state.sections.map(s => ({
+                key: s.key,
+                label: s.label,
+                keterangan: s.keterangan,
+                default: s.default,
+                saved: s.konten,
+                konten: s.konten,
+                error: null
+            }));
+            vm.active = keepActive && vm.sections.some(s => s.key === keepActive) ? keepActive : vm.sections[0].key;
+        }
+
+        function select(section)
+        {
+            vm.active = section.key;
+        }
+
+        // Newlines/trailing whitespace are not a "change" (the server compares the same way).
+        function normalize(text)
+        {
+            return (text || '').replace(/\r\n?/g, '\n').replace(/\s+$/, '');
+        }
+
+        function isChanged(section)
+        {
+            return normalize(section.konten) !== normalize(section.saved);
+        }
+
+        function isCustom(section)
+        {
+            return normalize(section.konten) !== normalize(section.default);
+        }
+
+        function hasSectionError()
+        {
+            return vm.sections.some(s => !!s.error);
+        }
+
+        function isLayoutChanged()
+        {
+            return !angular.equals(vm.layout, vm.layoutSaved);
+        }
+
+        function isLayoutCustom()
+        {
+            return !angular.equals(vm.layout, vm.layoutStandar);
+        }
+
+        function hasUnsaved()
+        {
+            return vm.sections.some(isChanged) || isLayoutChanged();
+        }
+
+        // Hand-written program code wins over the "program in several rows" setting.
+        function programCustom()
+        {
+            let section = vm.sections.find(s => s.key === 'program');
+
+            return !!section && isCustom(section);
+        }
+
+        // Drag & drop target: put the dragged block where the other one is.
+        function moveBlock(from, to)
+        {
+            let order = vm.layout.urutan;
+
+            if (from === to || from < 0 || to < 0 || from >= order.length || to >= order.length)
+            {
+                return;
+            }
+
+            order.splice(to, 0, order.splice(from, 1)[0]);
+        }
+
+        // Same thing for keyboard / touch users, who cannot drag.
+        function shiftBlock(index, delta)
+        {
+            moveBlock(index, index + delta);
+        }
+
+        function resetLayout()
+        {
+            if (isLayoutCustom() && !$window.confirm('Kembalikan tata letak visual ke standar? (Belum tersimpan sampai Anda menekan Simpan.)'))
+            {
+                return;
+            }
+
+            vm.layout = angular.copy(vm.layoutStandar);
+        }
+
+        // Inserts a variable snippet into the code editor of the active section, at the cursor.
+        function insertVariable(variable)
+        {
+            let section = vm.sections.find(s => s.key === vm.active);
+            let textarea = $window.document.getElementById(`kwitansi-editor-${vm.active}`);
+
+            if (!section || !textarea || textarea.disabled)
+            {
+                return;
+            }
+
+            let start = typeof textarea.selectionStart === 'number' ? textarea.selectionStart : section.konten.length;
+            let end = typeof textarea.selectionEnd === 'number' ? textarea.selectionEnd : start;
+
+            section.konten = section.konten.slice(0, start) + variable.sisip + section.konten.slice(end);
+
+            let caret = start + variable.sisip.length;
+            $timeout(() => {
+                textarea.focus();
+                textarea.setSelectionRange(caret, caret);
+            });
+        }
+
+        function resetSection(section)
+        {
+            if (isCustom(section) && !$window.confirm(`Kembalikan bagian "${section.label}" ke template standar? (Belum tersimpan sampai Anda menekan Simpan.)`))
+            {
+                return;
+            }
+
+            section.konten = section.default;
+            section.error = null;
+        }
+
+        function discardAll()
+        {
+            if (!$window.confirm('Batalkan semua perubahan yang belum disimpan?'))
+            {
+                return;
+            }
+
+            vm.sections.forEach(s => {
+                s.konten = s.saved;
+                s.error = null;
+            });
+            vm.layout = angular.copy(vm.layoutSaved);
+            vm.saveError = null;
+        }
+
+        function applyExample(section, example)
+        {
+            if (isCustom(section) && !$window.confirm(`Ganti isi bagian "${section.label}" dengan contoh ini?`))
+            {
+                return;
+            }
+
+            section.konten = example.konten;
+            section.error = null;
+        }
+
+        function payload()
+        {
+            let sections = {};
+            vm.sections.forEach(s => sections[s.key] = s.konten);
+
+            return sections;
+        }
+
+        function refreshPreview()
+        {
+            vm.preview.loading = true;
+            vm.preview.error = null;
+            vm.sections.forEach(s => s.error = null);
+
+            let body = {
+                sections: payload(),
+                layout: vm.layout,
+                status: vm.preview.status,
+                tagihan_id: parseInt(vm.preview.tagihanId, 10) || null
+            };
+
+            return req.post(`${URL}/preview`, body).then(result => {
+                if (result.error)
+                {
+                    // Template problems come back in the body so they show here, not as a toast.
+                    vm.preview.error = result.error;
+                    angular.forEach(result.errors || {}, (message, key) => {
+                        let section = vm.sections.find(s => s.key === key);
+                        if (section)
+                        {
+                            section.error = message;
+                            vm.active = key;
+                            vm.mode = 'kode'; // the message is shown under the code
+                        }
+                    });
+                    return;
+                }
+
+                vm.preview.pages = result.pages;
+                showPdf(result.data);
+            }).catch(angular.noop).finally(() => {
+                vm.preview.loading = false;
+            });
+        }
+
+        function showPdf(base64)
+        {
+            let binary = $window.atob(base64);
+            let bytes = new Uint8Array(binary.length);
+            for (let i = 0; i < binary.length; i++)
+            {
+                bytes[i] = binary.charCodeAt(i);
+            }
+
+            let url = $window.URL.createObjectURL(new $window.Blob([bytes], { type: 'application/pdf' }));
+            revokePreview();
+            previewUrl = url;
+
+            let frame = $window.document.getElementById('kwitansiPreviewFrame');
+            if (frame)
+            {
+                frame.setAttribute('src', url + '#toolbar=0&navpanes=0&view=Fit');
+            }
+        }
+
+        function revokePreview()
+        {
+            if (previewUrl)
+            {
+                $window.URL.revokeObjectURL(previewUrl);
+                previewUrl = null;
+            }
+        }
+
+        function save()
+        {
+            vm.saving = true;
+            vm.saveError = null;
+
+            return req.post(`${URL}/save`, { sections: payload(), layout: vm.layout }).then(state => {
+                applyState(state, vm.active);
+                logger.success('Template kwitansi disimpan');
+                return refreshPreview();
+            }).catch(message => {
+                // The server rejects invalid templates; keep the text and show why.
+                vm.saveError = message;
+            }).finally(() => {
+                vm.saving = false;
+            });
+        }
+
+        // Don't lose a long editing session by clicking a menu item.
+        $scope.$on('$stateChangeStart', event => {
+            if (hasUnsaved() && !$window.confirm('Ada perubahan template yang belum disimpan. Tinggalkan halaman ini?'))
+            {
+                event.preventDefault();
+            }
+        });
+
+        $scope.$on('$destroy', revokePreview);
+    }
+})()
diff --git a/b/Frontend/module/konfigurasi/template_kwitansi/template_kwitansi.directive.js b/Frontend/module/konfigurasi/template_kwitansi/template_kwitansi.directive.js
new file mode 100644
index 0000000..4701b6d
--- /dev/null
+++ b/Frontend/module/konfigurasi/template_kwitansi/template_kwitansi.directive.js
@@ -0,0 +1,92 @@
+(() => {
+    "use strict";
+
+    // Native HTML5 drag & drop (no library): reorder blocks, and drag text snippets into a textarea.
+    angular.module('app.module.konfigurasi.template_kwitansi')
+        .directive('kwitansiDragItem', kwitansiDragItem)
+        .directive('kwitansiDragText', kwitansiDragText);
+
+    kwitansiDragItem.$inject = ['$parse'];
+
+    /**
+     * Makes an element a sortable item: <li kwitansi-drag-item="$index" on-drop="vm.moveBlock(from, to)">.
+     * `from` is the index of the dragged item, `to` the index of the item it was dropped on.
+     */
+    function kwitansiDragItem($parse)
+    {
+        const TYPE = 'text/x-kwitansi-block';
+
+        return {
+            restrict: 'A',
+            link: (scope, element, attrs) => {
+                const el = element[0];
+                const onDrop = $parse(attrs.onDrop);
+                const index = () => scope.$eval(attrs.kwitansiDragItem);
+                const isBlockDrag = e => Array.prototype.indexOf.call(e.dataTransfer.types || [], TYPE) > -1;
+
+                el.setAttribute('draggable', 'true');
+
+                el.addEventListener('dragstart', e => {
+                    e.dataTransfer.effectAllowed = 'move';
+                    e.dataTransfer.setData(TYPE, String(index()));
+                    e.dataTransfer.setData('text/plain', String(index())); // Firefox only starts a drag with a standard type
+                    el.style.opacity = '0.5';
+                });
+
+                el.addEventListener('dragend', () => {
+                    el.style.opacity = '';
+                    el.style.outline = '';
+                });
+
+                el.addEventListener('dragover', e => {
+                    if (isBlockDrag(e))
+                    {
+                        e.preventDefault(); // allow dropping here
+                        e.dataTransfer.dropEffect = 'move';
+                        el.style.outline = '2px dashed #5e72e4';
+                    }
+                });
+
+                el.addEventListener('dragleave', () => {
+                    el.style.outline = '';
+                });
+
+                el.addEventListener('drop', e => {
+                    if (!isBlockDrag(e))
+                    {
+                        return;
+                    }
+
+                    e.preventDefault();
+                    el.style.outline = '';
+
+                    const from = parseInt(e.dataTransfer.getData(TYPE), 10);
+                    if (!isNaN(from))
+                    {
+                        scope.$apply(() => onDrop(scope, { from: from, to: index() }));
+                    }
+                });
+            }
+        };
+    }
+
+    /**
+     * <span kwitansi-drag-text="variable.sisip">: dragging it onto a textarea inserts the text where it is
+     * dropped (the browser does that natively and fires `input`, so ng-model stays in sync).
+     */
+    function kwitansiDragText()
+    {
+        return {
+            restrict: 'A',
+            link: (scope, element, attrs) => {
+                const el = element[0];
+
+                el.setAttribute('draggable', 'true');
+                el.addEventListener('dragstart', e => {
+                    e.dataTransfer.effectAllowed = 'copy';
+                    e.dataTransfer.setData('text/plain', scope.$eval(attrs.kwitansiDragText));
+                });
+            }
+        };
+    }
+})()
