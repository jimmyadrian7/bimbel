+    .program-grid td { padding-right: 10px; }
+    .program-grid .jarak { height: 4px; line-height: 4px; font-size: 1px; }
+</style>
+<table class="program-grid">
+    {% for baris in program_belajars|batch(per_baris) %}
+    <tr>
+        <td>{{ loop.first ? 'Program Belajar' : '' }}</td>
+        <td>{{ loop.first ? ':' : '' }}</td>
+        {% for program in baris %}
+        <td>
+            <div class="checkbox-pdf">
+                <input type="checkbox" {{ tagihan.program_belajar==program.nama ? 'checked' : '' }}>
+            </div> {{ program.nama }}
+        </td>
+        {% endfor %}
+        {% if loop.last and baris|length < per_baris %}
+        <td>
+            <div class="checkbox-pdf">
+                <input type="checkbox" {{ program_belajar_is_other ? 'checked' : '' }}>
+            </div>
+            <div class="other-options">{{ program_belajar_is_other ? tagihan.program_belajar : '' }}</div>
+        </td>
+        {% endif %}
+    </tr>
+    {% if layout.program.mandarin %}
+    <tr>
+        <td>
+            {% if loop.first %}<div class="checkbox-no-border"></div> <span class="mandarin">补习项目</span>{% endif %}
+        </td>
+        <td></td>
+        {% for program in baris %}
+        <td>
+            <div class="checkbox-no-border"></div>
+            <span class="mandarin">{{ program.nama_mandarin }}</span>
+        </td>
+        {% endfor %}
+    </tr>
+    {% endif %}
+    {% endfor %}
+    {% if program_belajars|length % per_baris == 0 %}
+    <tr>
+        <td></td>
+        <td></td>
+        <td colspan="3">
+            <div class="checkbox-pdf">
+                <input type="checkbox" {{ program_belajar_is_other ? 'checked' : '' }}>
+            </div>
+            <div class="other-options">{{ program_belajar_is_other ? tagihan.program_belajar : '' }}</div>
+        </td>
+    </tr>
+    {% endif %}
+
